# Postgres-Verbindung des Backends (beliebiger Anbieter).
# Lokal: postgres://postgres:postgres@localhost:5432/wertebarometer
# Vercel: Connection Pooler im Transaktionsmodus (z. B. Supabase Port 6543, Neon „pooled“)
DATABASE_URL=

# Anmeldedienst im Backend und Frontend: supabase oder neon
AUTH_PROVIDER=supabase
VITE_AUTH_PROVIDER=supabase

# Supabase Auth (nur mit AUTH_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: geheimer Supabase-Schlüssel für Einladungen neuer Benutzer (nur Backend)
SUPABASE_SECRET_KEY=

# Frontend (Vite liest nur Variablen mit Präfix VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Neon Auth (nur mit AUTH_PROVIDER=neon)
# Basis-URL aus der Neon-Konsole (Branch → Auth → Configuration)
NEON_AUTH_BASE_URL=
# Geheim, mindestens 32 Zeichen (z. B. `openssl rand -base64 32`); nur Backend
NEON_AUTH_COOKIE_SECRET=
# Optional für Einladungen neuer Benutzer: Neon-API-Schlüssel (geheim), Projekt- und Branch-ID
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
