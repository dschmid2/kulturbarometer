# Postgres-Verbindung des Backends.
# Lokal: postgres://postgres:postgres@localhost:5432/kulturbarometer
# Vercel: Supabase Connection Pooler im Transaktionsmodus (Port 6543)
DATABASE_URL=

# Supabase-Projekt (für Login der Administratoren)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: geheimer Supabase-Schlüssel für Einladungen neuer Benutzer (nur Backend)
SUPABASE_SECRET_KEY=

# Frontend (Vite liest nur Variablen mit Präfix VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
